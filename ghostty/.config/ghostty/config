# General
shell-integration = detect
shell-integration-features = no-cursor
cursor-style = block
theme = dark:Catppuccin Frappe,light:Apple System Colors Light
window-inherit-working-directory = false
mouse-hide-while-typing = true
window-save-state = always
window-new-tab-position = end

# For tmux keybinds to work
keybind = super+h=unbind
keybind = cmd+,=unbind

keybind = ctrl+n=new_window

keybind = cmd+h=goto_split:left
keybind = cmd+j=goto_split:bottom
keybind = cmd+k=goto_split:top
keybind = cmd+l=goto_split:right

keybind = cmd+ctrl+h=new_split:left
keybind = cmd+ctrl+j=new_split:down
keybind = cmd+ctrl+k=new_split:up
keybind = cmd+ctrl+l=new_split:right
keybind = cmd+ctrl+f=toggle_split_zoom


keybind = cmd+,=toggle_split_zoom
keybind = cmd+o=next_tab
keybind = cmd+i=previous_tab
keybind = cmd+shift+o=move_tab:1
keybind = cmd+shift+i=move_tab:-1

keybind = super+r=reload_config
